{
  "compilerOptions": {
    "outDir": "../.tmp/workflow-tests",
    "rootDir": "..",
    "baseUrl": "..",
    "paths": {
      "@/*": ["./src/*"]
    },
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "./workflowCharacterization.contracttest.ts",
    "../src/lib/datasetItems.ts",
    "../src/lib/api.ts",
    "../src/lib/apiShared.ts"
  ]
}
